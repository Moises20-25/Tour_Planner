<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reporte de reservas | Tour Planner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
    <style>
        @media print {
            nav, .navbar, .no-print { display: none !important; }
        }
    </style>
</head>
<body>
<div th:replace="~{fragments/navbar :: navbar('rreservas')}"></div>

<main class="container my-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="mb-1">Reporte de reservas</h2>
            <p class="text-muted mb-0">Emitido: <span th:text="${fechaEmision}">01/01/2026 10:00</span></p>
        </div>
        <button type="button" class="btn btn-outline-secondary no-print" onclick="window.print()">
            Imprimir / guardar PDF
        </button>
    </div>

    <form class="card card-body mb-3 no-print" method="get" th:action="@{/reporte/reservas}">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Reservado desde</label>
                <input type="date" class="form-control" name="desde" th:value="${desde}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Reservado hasta</label>
                <input type="date" class="form-control" name="hasta" th:value="${hasta}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select class="form-select" name="estado">
                    <option value="" th:selected="${estadoSel == null or estadoSel == ''}">-- Todos --</option>
                    <option value="confirmada" th:selected="${estadoSel == 'confirmada'}">Confirmada</option>
                    <option value="cancelada" th:selected="${estadoSel == 'cancelada'}">Cancelada</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a th:href="@{/reporte/reservas}" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
    </form>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">Total de reservas</div>
                    <div class="fs-3 fw-bold" th:text="${totalReservas}">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">Monto total (sin canceladas)</div>
                    <div class="fs-3 fw-bold text-primary"
                         th:text="'S/ ' + ${#numbers.formatDecimal(montoTotal, 1, 'COMMA', 2, 'POINT')}">S/ 0.00</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Reservado el</th>
                            <th>Viaje</th>
                            <th>Paquete</th>
                            <th>Viajeros</th>
                            <th>Estado</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr th:each="r : ${lstReservas}">
                            <td th:text="${r.codigoReserva}">RES-0</td>
                            <td th:text="${r.usuario.nombreCompleto}">Cliente</td>
                            <td th:text="${#temporals.format(r.fechaReserva, 'dd/MM/yyyy HH:mm')}">01/01/2026</td>
                            <td th:text="${#temporals.format(r.fechaInicio, 'dd/MM/yyyy') + ' - ' + #temporals.format(r.fechaFin, 'dd/MM/yyyy')}">fechas</td>
                            <td>
                                <div th:each="d : ${r.detalles}"
                                     th:text="${(d.paquete?.nombre ?: d.servicio?.nombre) + ' x' + d.cantidad}">Paquete</div>
                            </td>
                            <td th:text="${r.pasajeros}">1</td>
                            <td>
                                <span class="badge"
                                      th:classappend="${r.estado == 'confirmada'} ? 'bg-success' : 'bg-danger'"
                                      th:text="${r.estado}">confirmada</span>
                            </td>
                            <td class="text-end"
                                th:text="'S/ ' + ${#numbers.formatDecimal(r.montoTotal, 1, 'COMMA', 2, 'POINT')}">S/ 0.00</td>
                        </tr>
                        <tr th:if="${#lists.isEmpty(lstReservas)}">
                            <td colspan="8" class="text-center text-muted">No hay reservas para los filtros elegidos.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
</body>
</html>